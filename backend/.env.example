APP_NAME=权限感知的 RAG 企业文档知识助手
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/enterprise_knowledge_assistant
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
JWT_SECRET_KEY=dev-enterprise-knowledge-assistant-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=120
SEED_MOCK_DATA=true
SEED_DEMO_EVAL_CASES=true
DATA_DIR=
EMBEDDING_PROVIDER=deterministic
ANSWER_PROVIDER=openai_compatible
ROUTER_PROVIDER=openai_compatible
DIFF_SUMMARY_PROVIDER=openai_compatible

# OpenAI-compatible LLM settings (DeepSeek example)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_ROUTER_MODEL=deepseek-v4-flash
LLM_CHAT_MODEL=deepseek-v4-flash
LLM_REASONING_MODEL=deepseek-v4-pro

# OpenAI-compatible embedding settings (OpenRouter example)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_ROUTER_MODEL=gpt-4.1-mini
OPENAI_DIFF_MODEL=gpt-4.1-mini
EMBEDDING_DIMENSIONS=1536
CHUNK_TARGET_CHARS=900
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_SEGMENTS=1
CHAT_HISTORY_WINDOW=6

# OCR ingestion settings
ENABLE_OCR=false
OCR_LANG=chi_sim+eng
OCR_MIN_TEXT_CHARS=40
OCR_IMAGE_DPI=200
OCR_MAX_PAGES=30
OCR_MAX_IMAGE_PIXELS=25000000
OCR_IMAGE_MIN_TEXT_CHARS=20
OCR_IMAGE_MIN_TOKENS=5
OCR_FILTER_NOISE_TEXT=true
