APP_NAME=Enterprise Knowledge Assistant
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/enterprise_knowledge_assistant
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=120
SEED_MOCK_DATA=true
SEED_DEMO_EVAL_CASES=true
DATA_DIR=
EMBEDDING_PROVIDER=deterministic
ANSWER_PROVIDER=deterministic
DIFF_SUMMARY_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_DIFF_MODEL=gpt-4.1-mini
EMBEDDING_DIMENSIONS=1536
CHUNK_TARGET_CHARS=900
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_SEGMENTS=1
CHAT_HISTORY_WINDOW=6
